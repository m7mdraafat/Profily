dotnet_diagnostic.MA0029.severity = error    # Combine LINQ methods
dotnet_diagnostic.MA0036.severity = error    # Make class static
dotnet_diagnostic.MA0040.severity = error    # Forward the CancellationToken parameter
dotnet_diagnostic.MA0042.severity = error    # Do not use blocking calls in an async method
