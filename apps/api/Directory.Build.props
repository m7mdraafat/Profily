<!--
  Profily — Directory.Build.props
  Applies to ALL .NET projects in the solution.
  Enforces: analyzers, warnings-as-errors, code quality.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Treat ALL warnings as errors -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />

    <!-- Enable .NET analyzers at highest level -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Code analysis during build -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>

    <!-- Produce XML docs warnings if public API isn't documented -->
    <!-- Disabled for now — enable when stabilizing public API -->
    <!-- <GenerateDocumentationFile>true</GenerateDocumentationFile> -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Analyzers applied to all projects -->
  <ItemGroup>
    <!-- Meziantou — comprehensive .NET analyzer (900+ rules) -->
    <PackageReference Include="Meziantou.Analyzer" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- SecurityCodeScan — OWASP security analysis -->
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- AsyncFixer — async/await anti-pattern detection -->
    <PackageReference Include="AsyncFixer" Version="1.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
